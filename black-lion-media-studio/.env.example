# Local development only. Production auth requires SESSION_SECRET from a secure runtime secret binding.
# Do not add production secrets to dotenv files or source control.
# Square appointments also require SQUARE_ACCESS_TOKEN and SQUARE_WEBHOOK_SIGNATURE_KEY
# from Secret Manager, plus these non-secret catalog/location identifiers:
# SQUARE_LOCATION_ID=
# SQUARE_CONSULTATION_SERVICE_VARIATION_ID=
# SQUARE_ENVIRONMENT=sandbox
# Square payment webhooks have their own signature key and should be registered at
# SQUARE_PAYMENTS_WEBHOOK_URL (or use the matching same-key webhook configuration).

# Optional backend integrations. Production secrets belong in Firebase Secret Manager.
FIREBASE_STORAGE_BUCKET=
SQUARE_PAYMENTS_WEBHOOK_URL=https://black-lion-media-studio.web.app/api/square/payments/webhook
# SQUARE_PAYMENTS_WEBHOOK_SIGNATURE_KEY is a separate Secret Manager secret for this endpoint.
SQUARE_PAYMENTS_WEBHOOK_SIGNATURE_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER and SMTP_PASS are runtime Secret Manager bindings in production.
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SITE_BASE_URL=https://black-lion-media-studio.web.app
